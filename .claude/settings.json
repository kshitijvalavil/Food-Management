{
  "permissions": {
    "allow": [
      "Bash(npm *)", "Bash(npx *)", "Bash(node *)", "Bash(git *)", "Bash(gh pr *)", "Bash(gh run *)",
      "Bash(vercel *)", "Bash(npx vercel *)", "Bash(supabase *)", "Bash(npx playwright *)", "Bash(npx lighthouse *)", "Bash(deno *)",
      "Edit", "Write", "Read", "Glob", "Grep", "WebSearch", "WebFetch"
